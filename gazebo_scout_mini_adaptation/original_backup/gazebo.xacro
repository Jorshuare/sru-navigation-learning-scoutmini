<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

    <gazebo>
        <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
            <left_joint>front_left_wheel</left_joint>
            <left_joint>rear_left_wheel</left_joint>
            <right_joint>front_right_wheel</right_joint>
            <right_joint>rear_right_wheel</right_joint>
            <wheel_separation>0.58306</wheel_separation>
            <wheel_radius>0.16459</wheel_radius>
            <odom_publish_frequency>50</odom_publish_frequency>
            <topic>cmd_vel</topic>
            <odom_topic>odom</odom_topic>
            <frame_id>odom</frame_id>
            <child_frame_id>base_link</child_frame_id>
            <tf_topic>tf</tf_topic>
        </plugin>
        <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
            <topic>joint_states</topic>
        </plugin>
    </gazebo>

    <link name="zed_x_camera">
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><box size="0.05 0.1 0.01"/></geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.01"/>
            <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
        </inertial>
    </link>

    <joint name="base_to_zed_x_camera" type="fixed">
        <parent link="base_link"/>
        <child link="zed_x_camera"/>
        <origin xyz="0.25 0.0 0.25" rpy="0 0.349066 0"/>
    </joint>

    <gazebo reference="base_to_zed_x_camera">
        <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <gazebo reference="zed_x_camera">
        <sensor name="zed_x_camera" type="depth_camera">
            <always_on>1</always_on>
            <update_rate>15</update_rate>
            <visualize>true</visualize>
            <topic>zed_x_camera</topic>
            <camera>
                <horizontal_fov>1.845264</horizontal_fov>
                <image>
                    <width>240</width>
                    <height>150</height>
                    <format>R_FLOAT32</format>
                </image>
                <clip><near>0.3</near><far>20.0</far></clip>
                <optical_frame_id>zed_x_camera</optical_frame_id>
                <depth_camera><output>depths</output></depth_camera>
            </camera>
        </sensor>
    </gazebo>

</robot>
